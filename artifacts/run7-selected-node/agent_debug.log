atch\nfrom lenskit.algorithms import Recommender\nfrom lenskit.algorithms.basic import Popular\nfrom lenskit.algorithms.als import ImplicitMF\nfrom lenskit.algorithms.item_knn import ItemItem\n\nSEEDS = [1, 7, 21, 42, 84]\nKS = [1, 5, 10]\nMAX_K = max(KS)\nFILES = {\n    \'ml100k\': \'u.data\',\n    \'amazon_videogames\': \'VideoGames.csv\',\n    \'lastfm\': \'UserTaggedArtists-timestamps.dat\'\n}\n\nexperiment_data = {\n    \'ml100k\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': []},\n    \'amazon_videogames\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': []},\n    \'lastfm\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': []},\n}\n\n\ndef check_file(path):\n    if not os.path.exists(path):\n        raise FileNotFoundError(f\'Missing required input file: {path}\')\n\n\ndef k_core_filter(df, user_col=\'user\', item_col=\'item\', min_k=5):\n    df = df[[user_col, item_col]].dropna().drop_duplicates().copy()\n    if df.empty:\n        raise ValueError(\'Dataset is empty before k-core filtering.\')\n    while True:\n        uc = df[user_col].value_counts()\n        ic = df[item_col].value_counts()\n        keep_u = uc[uc >= min_k].index\n        keep_i = ic[ic >= min_k].index\n        new_df = df[df[user_col].isin(keep_u) & df[item_col].isin(keep_i)]\n        if len(new_df) == len(df):\n            break\n        if new_df.empty:\n            raise ValueError(\'Dataset became empty during 5-core filtering.\')\n        df = new_df\n    return df.reset_index(drop=True)\n\n\ndef load_ml100k(path):\n    check_file(path)\n    df = pd.read_csv(path, sep=\'\\t\', header=None, names=[\'user\', \'item\', \'rating\', \'timestamp\'])\n    if not {\'user\', \'item\', \'rating\'}.issubset(df.columns):\n        raise ValueError(\'MovieLens schema mismatch.\')\n    df = df[df[\'rating\'] > 3][[\'user\', \'item\']]\n    return k_core_filter(df)\n\n\ndef load_amazon(path):\n    check_file(path)\n    raw = pd.read_csv(path)\n    if raw.shape[1] < 3:\n        raise ValueError(\'Amazon file must have at least 3 columns.\')\n    cols = {c.lower(): c for c in raw.columns}\n    ucol = cols.get(\'user_id\', cols.get(\'userid\', cols.get(\'reviewerid\', raw.columns[0])))\n    icol = cols.get(\'item_id\', cols.get(\'asin\', raw.columns[1]))\n    rcol = cols.get(\'rating\', cols.get(\'overall\', raw.columns[2]))\n    df = raw[[ucol, icol, rcol]].rename(columns={ucol: \'user\', icol: \'item\', rcol: \'rating\'})\n    df = df[df[\'rating\'] > 3][[\'user\', \'item\']]\n    return k_core_filter(df)\n\n\ndef load_lastfm(path):\n    check_file(path)\n    df = pd.read_csv(path, sep=\'\\t\')\n    cols = {c.lower(): c for c in df.columns}\n    if len(df.columns) < 2:\n        raise ValueError(\'LastFM schema mismatch.\')\n    ucol = cols.get(\'userid\', df.columns[0])\n    icol = cols.get(\'artistid\', df.columns[1])\n    out = df[[ucol, icol]].rename(columns={ucol: \'user\', icol: \'item\'})\n    return k_core_filter(out)\n\n\ndef user_holdout_split(df, seed, test_frac=0.2):\n    rng = np.random.default_rng(seed)\n    train_parts, test_parts = [], []\n    supported_users = 0\n    for _, udf in df.groupby(\'user\', sort=False):\n        n = len(udf)\n        if n < 2:\n            continue\n        n_test = max(1, int(np.floor(n * test_frac)))\n        if n_test >= n:\n            n_test = n - 1\n        if n_test < 1 or (n - n_test) < 1:\n            continue\n        idx = np.arange(n)\n        test_idx = rng.choice(idx, size=n_test, replace=False)\n        mask = np.zeros(n, dtype=bool)\n        mask[test_idx] = True\n        test_parts.append(udf.iloc[mask])\n        train_parts.append(udf.iloc[~mask])\n        supported_users += 1\n    if supported_users == 0:\n        raise ValueError(\'No users support the holdout protocol.\')\n    return pd.concat(train_parts, ignore_index=True), pd.concat(test_parts, ignore_index=True), supported_users\n\n\ndef build_algorithms():\n    return {\n        \'ALS\': Recommender.adapt(ImplicitMF()),\n        \'ItemKNN\': Recommender.adapt(ItemItem()),\n        \'Pop\': Recommender.adapt(Popular())\n    }\n\n\ndef precision_at_k(rec_items, truth_items, k):\n    hits = [len(rec_items[u][:k] & truth_items[u]) / k for u in truth_items]\n    return float(np.mean(hits)) if hits else np.nan\n\n\ndef ndcg_at_k(rec_lists, truth_items, k):\n    vals = []\n    for u in truth_items:\n        ranked = rec_lists[u][:k]\n        dcg = sum((1.0 / np.log2(i + 2)) for i, it in enumerate(ranked) if it in truth_items[u])\n        ideal = min(len(truth_items[u]), k)\n        idcg = sum(1.0 / np.log2(i + 2) for i in range(ideal))\n        vals.append(dcg / idcg if idcg > 0 else 0.0)\n    return float(np.mean(vals)) if vals else np.nan\n\n\ndef evaluate_algo(algo, train, test):\n    algo.fit(train)\n    users = test[\'user\'].drop_duplicates().tolist()\n    try:\n        recs = batch.recommend(algo, users, MAX_K)\n    except Exception:\n        recs = batch.recommend(algo, users, MAX_K, candidates=None)\n    if recs is None or len(recs) == 0:\n        raise ValueError(\'No recommendations produced.\')\n    truth = test.groupby(\'user\')[\'item\'].agg(lambda x: set(x)).to_dict()\n    seen = train.groupby(\'user\')[\'item\'].agg(lambda x: set(x)).to_dict()\n    rec_lists = {}\n    rec_sets = {}\n    kept_rows = []\n    for u, udf in recs.groupby(\'user\', sort=False):\n        items = [it for it in udf[\'item\'].tolist() if it not in seen.get(u, set())]\n        items = items[:MAX_K]\n        rec_lists[u] = items\n        rec_sets[u] = set(items)\n        kept_rows.extend([(u, it, r + 1) for r, it in enumerate(items)])\n    for u in truth:\n        rec_lists.setdefault(u, [])\n        rec_sets.setdefault(u, set())\n    rows = []\n    for k in KS:\n        rows.append((\'Precision\', k, precision_at_k(rec_sets, truth, k)))\n        rows.append((\'nDCG\', k, ndcg_at_k(rec_lists, truth, k)))\n    return rows, pd.DataFrame(kept_rows, columns=[\'user\', \'item\', \'rank\']), truth\n\n\ndef ci95(x):\n    x = pd.Series(x).dropna()\n    if len(x) <= 1:\n        return np.nan\n    return 1.96 * x.std(ddof=1) / np.sqrt(len(x))\n\n\ndatasets = {}\nloaders = {\n    \'ml100k\': load_ml100k,\n    \'amazon_videogames\': load_amazon,\n    \'lastfm\': load_lastfm,\n}\nfor name, path in FILES.items():\n    datasets[name] = loaders[name](path)\n    print(f\'Loaded {name}: interactions={len(datasets[name])}, users={datasets[name].user.nunique()}, items={datasets[name].item.nunique()}\')\n\nall_rows = []\nrun_status = []\nfor dname, df in datasets.items():\n    for seed in SEEDS:\n        train, test, eval_users = user_holdout_split(df, seed, 0.2)\n        algos = build_algorithms()\n        for aname, algo in algos.items():\n            ts = pd.Timestamp.now().isoformat()\n            print(f\'Epoch {seed}: validation_loss = {float("nan"):.4f}\')\n            try:\n                metric_rows, recs_df, truth = evaluate_algo(algo, train, test)\n                for mname, k, score in metric_rows:\n                    all_rows.append({\n                        \'dataset\': dname,\n                        \'algorithm\': aname,\n                        \'seed\': seed,\n                        \'metric_name\': mname,\n                        \'k\': k,\n                        \'score\': score,\n                        \'evaluation_user_count\': eval_users,\n                        \'timestamp\': ts\n                    })\n                experiment_data[dname][\'metrics\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'n_train\': len(train), \'timestamp\': ts})\n                experiment_data[dname][\'metrics\'][\'val\'].extend([r for r in all_rows if r[\'dataset\'] == dname and r[\'algorithm\'] == aname and r[\'seed\'] == seed])\n                experiment_data[dname][\'losses\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'loss\': np.nan, \'timestamp\': ts})\n                experiment_data[dname][\'losses\'][\'val\'].append({\'seed\': seed, \'algorithm\': aname, \'loss\': np.nan, \'timestamp\': ts})\n                experiment_data[dname][\'predictions\'].append({\'seed\': seed, \'algorithm\': aname, \'rows\': recs_df.to_dict(\'records\')[:5000]})\n                experiment_data[dname][\'ground_truth\'].append({\'seed\': seed, \'algorithm\': aname, \'truth\': {str(k): list(v)[:100] for k, v in truth.items()}})\n                run_status.append({\'dataset\': dname, \'algorithm\': aname, \'seed\': seed, \'status\': \'ok\', \'evaluation_user_count\': eval_users})\n                print(dname, aname, seed, {f\'{m}@{k}\': round(s, 4) if pd.notna(s) else None for m, k, s in metric_rows})\n            except Exception as e:\n                run_status.append({\'dataset\': dname, \'algorithm\': aname, \'seed\': seed, \'status\': f\'failed: {e}\', \'evaluation_user_count\': eval_users})\n                for mname in [\'Precision\', \'nDCG\']:\n                    for k in KS:\n                        all_rows.append({\n                            \'dataset\': dname,\n                            \'algorithm\': aname,\n                            \'seed\': seed,\n                            \'metric_name\': mname,\n                            \'k\': k,\n                            \'score\': np.nan,\n                            \'evaluation_user_count\': eval_users,\n                            \'timestamp\': ts\n                        })\n                print(f\'Run failed for {dname}-{aname}-seed{seed}: {e}\')\n\nresults = pd.DataFrame(all_rows)\nstatus_df = pd.DataFrame(run_status)\nresults.to_csv(os.path.join(working_dir, \'seed_sensitivity_results_tidy.csv\'), index=False)\nstatus_df.to_csv(os.path.join(working_dir, \'run_status.csv\'), index=False)\n\nsummary = results.groupby([\'dataset\', \'algorithm\', \'metric_name\', \'k\'], as_index=False).agg(\n    mean_score=(\'score\', \'mean\'),\n    std_score=(\'score\', \'std\'),\n    min_score=(\'score\', \'min\'),\n    max_score=(\'score\', \'max\'),\n    ci95=(\'score\', ci95),\n    evaluation_user_count=(\'evaluation_user_count\', \'mean\')\n)\nsummary[\'cv\'] = summary[\'std_score\'] / summary[\'mean_score\'].replace(0, np.nan)\nsummary[\'range\'] = summary[\'max_score\'] - summary[\'min_score\']\nsummary.to_csv(os.path.join(working_dir, \'seed_sensitivity_summary.csv\'), index=False)\n\nmost_sensitive = summary.sort_values([\'cv\', \'std_score\', \'range\'], ascending=False).groupby([\'metric_name\', \'k\']).head(3)\nmost_sensitive.to_csv(os.path.join(working_dir, \'most_seed_sensitive_cases.csv\'), index=False)\n\nprint(\'\\nTidy per-seed results:\')\nprint(results.head(18).to_string(index=False))\nprint(\'\\nSeed sensitivity summary:\')\nprint(summary.to_string(index=False))\nprint(\'\\nMost seed-sensitive cases by metric:\')\nprint(most_sensitive[[\'dataset\', \'algorithm\', \'metric_name\', \'k\', \'mean_score\', \'std_score\', \'cv\', \'range\']].to_string(index=False))\n\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data, allow_pickle=True)\nnp.save(os.path.join(working_dir, \'results_tidy.npy\'), results.to_records(index=False), allow_pickle=True)\nnp.save(os.path.join(working_dir, \'summary.npy\'), summary.to_records(index=False), allow_pickle=True)\nnp.save(os.path.join(working_dir, \'status.npy\'), status_df.to_records(index=False), allow_pickle=True)\nnp.savez_compressed(\n    os.path.join(working_dir, \'all_outputs.npz\'),\n    results=results.to_records(index=False),\n    summary=summary.to_records(index=False),\n    status=status_df.to_records(index=False)\n)\n\nprint(f\'\\nCompleted experiment. Outputs saved in {working_dir}\')\n```', 'Execution Output': '```\nLoaded ml100k: interactions=54413, users=938, items=1008\nLoaded amazon_videogames: interactions=533133, us