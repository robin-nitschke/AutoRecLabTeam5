ed\': seed, \'algorithm\': aname, \'loss\': np.nan, \'timestamp\': ts})\n                experiment_data[dname][\'predictions\'].append({\'seed\': seed, \'algorithm\': aname, \'rows\': recs.to_dict(\'records\')[:1000]})\n                experiment_data[dname][\'ground_truth\'].append({\'seed\': seed, \'algorithm\': aname, \'truth_sample\': {str(k): list(v) for k, v in list(truth.items())[:1000]}})\n                print(dname, aname, seed, {f\'{m}@{k}\': round(s, 4) for m, k, s in metric_rows})\n            except Exception as e:\n                for metric_name in [\'Precision\', \'nDCG\']:\n                    for k in KS:\n                        all_rows.append({\n                            \'dataset\': dname, \'algorithm\': aname, \'seed\': seed,\n                            \'metric_name\': metric_name, \'k\': k, \'score\': np.nan,\n                            \'evaluation_user_count\': 0, \'eligible_user_count\': eligible_users,\n                            \'timestamp\': ts\n                        })\n                print(f\'FAILED {dname} {aname} seed={seed}: {e}\')\n\nresults_long = pd.DataFrame(all_rows)\nresults_wide = pd.DataFrame(run_rows)\nresults_long.to_csv(os.path.join(working_dir, \'seed_sensitivity_results_tidy.csv\'), index=False)\nresults_wide.to_csv(os.path.join(working_dir, \'seed_sensitivity_results_wide.csv\'), index=False)\n\nsummary = results_long.groupby([\'dataset\', \'algorithm\', \'metric_name\', \'k\']).agg(\n    mean_score=(\'score\', \'mean\'),\n    std_score=(\'score\', \'std\'),\n    min_score=(\'score\', \'min\'),\n    max_score=(\'score\', \'max\'),\n    mean_eval_users=(\'evaluation_user_count\', \'mean\')\n).reset_index()\nsummary[\'cv\'] = summary[\'std_score\'] / summary[\'mean_score\'].replace(0, np.nan)\nsummary.to_csv(os.path.join(working_dir, \'metric_summary_tidy.csv\'), index=False)\n\nfocus = summary[summary[\'k\'].isin([10])].copy()\nfocus = focus.sort_values([\'metric_name\', \'std_score\'], ascending=[True, Fal