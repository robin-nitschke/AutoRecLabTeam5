udf in df.groupby(\'user\', sort=False):\\n        n = len(udf)\\n        if n < 2:\\n            continue\\n        n_test = max(1, int(np.floor(n * test_frac)))\\n        n_test = min(n_test, n - 1)\\n        idx = np.arange(n)\\n        test_idx = rng.choice(idx, size=n_test, replace=False)\\n        mask = np.zeros(n, dtype=bool)\\n        mask[test_idx] = True\\n        tr = udf.iloc[~mask]\\n        te = udf.iloc[mask]\\n        if len(tr) > 0 and len(te) > 0:\\n            train_parts.append(tr)\\n            test_parts.append(te)\\n            eval_users += 1\\n    if eval_users == 0:\\n        raise ValueError(\'No users support the holdout protocol\')\\n    train = pd.concat(train_parts, ignore_index=True)\\n    test = pd.concat(test_parts, ignore_index=True)\\n    return train, test, eval_users\\n\\n\\ndef build_algorithms():\\n    return {\\n        \'ALS\': Recommender.adapt(ImplicitMF()),\\n        \'ItemKNN\': Recommender.adapt(ItemItem()),\\n        \'Pop\': Recommender.adapt(Popular())\\n    }\\n\\n\\ndef metric_from_recs(recs_df, truth_map, k):\\n    rec_k = recs_df[recs_df[\'rank\'] <= k]\\n    rec_map = rec_k.groupby(\'user\')[\'item\'].apply(list).to_dict()\\n    pvals, ndcgvals = [], []\\n    for u, truth in truth_map.items():\\n        ranked = rec_map.get(u, [])\\n        hits = sum(1 for it in ranked if it in truth)\\n        pvals.append(hits / k)\\n        dcg = sum((1.0 / np.log2(i + 2)) for i, it in enumerate(ranked) if it in truth)\\n        ideal = min(len(truth), k)\\n        idcg = sum(1.0 / np.log2(i + 2) for i in range(ideal))\\n        ndcgvals.append(dcg / idcg if idcg > 0 else 0.0)\\n    return float(np.mean(pvals)), float(np.mean(ndcgvals))\\n\\n\\ndef evaluate_algo(algo, train, test, ks):\\n    truth = test.groupby(\'user\')[\'item\'].apply(set).to_dict()\\n    users = list(truth.keys())\\n    seen = train.groupby(\'user\')[\'item\'].apply(set).to_dict()\\n    algo.fit(train)\\n    try:\\n        recs = batch.recommend(algo, u