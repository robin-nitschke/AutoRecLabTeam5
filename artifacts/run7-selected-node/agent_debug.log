ode":"import os\\nworking_dir = os.path.join(os.getcwd(), \'working\')\\nos.makedirs(working_dir, exist_ok=True)\\n\\nimport warnings\\nwarnings.filterwarnings(\'ignore\')\\n\\nimport numpy as np\\nimport pandas as pd\\nfrom scipy import stats\\nfrom lenskit import batch\\nfrom lenskit.algorithms import Recommender\\nfrom lenskit.algorithms.basic import Popular\\nfrom lenskit.algorithms.als import ImplicitMF\\nfrom lenskit.algorithms.item_knn import ItemItem\\n\\nSEEDS = [1, 7, 21, 42, 84]\\nKS = [1, 5, 10]\\nMAX_K = max(KS)\\nFILES = {\\n    \'ml100k\': \'u.data\',\\n    \'amazon_videogames\': \'VideoGames.csv\',\\n    \'lastfm\': \'UserTaggedArtists-timestamps.dat\'\\n}\\n\\nexperiment_data = {\\n    \'ml100k\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': []},\\n    \'amazon_videogames\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': []},\\n    \'lastfm\': {\'metrics\': {\'train\': [], \'val\': []}, \'losses\': {\'train\': [], \'val\': []}, \'predictions\': [], \'ground_truth\': []},\\n}\\n\\n\\ndef check_file(path):\\n    if not os.path.exists(path):\\n        raise FileNotFoundError(f\'Missing required input file: {path}\')\\n\\n\\ndef k_core_filter(df, user_col=\'user\', item_col=\'item\', min_k=5):\\n    df = df[[user_col, item_col]].dropna().drop_duplicates().copy()\\n    if df.empty:\\n        raise ValueError(\'Dataset is empty before k-core filtering.\')\\n    while True:\\n        uc = df[user_col].value_counts()\\n        ic = df[item_col].value_counts()\\n        keep_u = uc[uc >= min_k].index\\n        keep_i = ic[ic >= min_k].index\\n        new_df = df[df[user_col].isin(keep_u) & df[item_col].isin(keep_i)]\\n        if len(new_df) == len(df):\\n            break\\n        if new_df.empty:\\n            raise ValueError(\'Dataset became empty during 5-core filtering.\')\\n        df = new_df\\n    return df.reset_index(drop=True)\\n\\n\\ndef load_ml100k(path):\\n    check_file(path)\\n    df = pd.read_csv(path, sep=\'\\\\t\', header=None, names=[\'user\', \'item\', \'rating\', \'timestamp\'])\\n    if not {\'user\', \'item\', \'rating\'}.issubset(df.columns):\\n        raise ValueError(\'MovieLens schema mismatch.\')\\n    df = df[df[\'rating\'] > 3][[\'user\', \'item\']]\\n    return k_core_filter(df)\\n\\n\\ndef load_amazon(path):\\n    check_file(path)\\n    raw = pd.read_csv(path)\\n    if raw.shape[1] < 3:\\n        raise ValueError(\'Amazon file must have at least 3 columns.\')\\n    cols = {c.lower(): c for c in raw.columns}\\n    ucol = cols.get(\'user_id\', cols.get(\'userid\', cols.get(\'reviewerid\', raw.columns[0])))\\n    icol = cols.get(\'item_id\', cols.get(\'asin\', raw.columns[1]))\\n    rcol = cols.get(\'rating\', cols.get(\'overall\', raw.columns[2]))\\n    df = raw[[ucol, icol, rcol]].rename(columns={ucol: \'user\', icol: \'item\', rcol: \'rating\'})\\n    df = df[df[\'rating\'] > 3][[\'user\', \'item\']]\\n    return k_core_filter(df)\\n\\n\\ndef load_lastfm(path):\\n    check_file(path)\\n    df = pd.read_csv(path, sep=\'\\\\t\')\\n    cols = {c.lower(): c for c in df.columns}\\n    if len(df.columns) < 2:\\n        raise ValueError(\'LastFM schema mismatch.\')\\n    ucol = cols.get(\'userid\', df.columns[0])\\n    icol = cols.get(\'artistid\', df.columns[1])\\n    out = df[[ucol, icol]].rename(columns={ucol: \'user\', icol: \'item\'})\\n    return k_core_filter(out)\\n\\n\\ndef user_holdout_split(df, seed, test_frac=0.2):\\n    rng = np.random.default_rng(seed)\\n    train_parts, test_parts = [], []\\n    supported_users = 0\\n    for _, udf in df.groupby(\'user\', sort=False):\\n        n = len(udf)\\n        if n < 2:\\n            continue\\n        n_test = max(1, int(np.floor(n * test_frac)))\\n        if n_test >= n:\\n            n_test = n - 1\\n        if n_test < 1 or (n - n_test) < 1:\\n            continue\\n        idx = np.arange(n)\\n        test_idx = rng.choice(idx, size=n_test, replace=False)\\n        mask = np.zeros(n, dtype=bool)\\n        mask[test_idx] = True\\n        test_parts.append(udf.iloc[mask])\\n        train_parts.append(udf.iloc[~mask])\\n        supported_users += 1\\n    if supported_users == 0:\\n        raise ValueError(\'No users support the holdout protocol.\')\\n    return pd.concat(train_parts, ignore_index=True), pd.concat(test_parts, ignore_index=True), supported_users\\n\\n\\ndef build_algorithms():\\n    return {\\n        \'ALS\': Recommender.adapt(ImplicitMF()),\\n        \'ItemKNN\': Recommender.adapt(ItemItem()),\\n        \'Pop\': Recommender.adapt(Popular())\\n    }\\n\\n\\ndef precision_at_k(rec_items, truth_items, k):\\n    hits = [len(rec_items[u][:k] & truth_items[u]) / k for u in truth_items]\\n    return float(np.mean(hits)) if hits else np.nan\\n\\n\\ndef ndcg_at_k(rec_lists, truth_items, k):\\n    vals = []\\n    for u in truth_items:\\n        ranked = rec_lists[u][:k]\\n        dcg = sum((1.0 / np.log2(i + 2)) for i, it in enumerate(ranked) if it in truth_items[u])\\n        ideal = min(len(truth_items[u]), k)\\n        idcg = sum(1.0 / np.log2(i + 2) for i in range(ideal))\\n        vals.append(dcg / idcg if idcg > 0 else 0.0)\\n    return float(np.mean(vals)) if vals else np.nan\\n\\n\\ndef evaluate_algo(algo, train, test):\\n    algo.fit(train)\\n    users = test[\'user\'].drop_duplicates().tolist()\\n    try:\\n        recs = batch.recommend(algo, users, MAX_K)\\n    except Exception:\\n        recs = batch.recommend(algo, users, MAX_K, candidates=None)\\n    if recs is None or len(recs) == 0:\\n        raise ValueError(\'No recommendations produced.\')\\n    truth = test.groupby(\'user\')[\'item\'].agg(lambda x: set(x)).to_dict()\\n    seen = train.groupby(\'user\')[\'item\'].agg(lambda x: set(x)).to_dict()\\n    rec_lists = {}\\n    rec_sets = {}\\n    kept_rows = []\\n    for u, udf in recs.groupby(\'user\', sort=False):\\n  