ma mismatch\')\\n    df = df[df[\'rating\'] > 3][[\'user\', \'item\']]\\n    return k_core_filter(df)\\n\\n\\ndef load_amazon(path):\\n    require_file(path)\\n    raw = pd.read_csv(path)\\n    cols = {c.lower(): c for c in raw.columns}\\n    ucol = next((cols[k] for k in [\'user_id\', \'userid\', \'reviewerid\'] if k in cols), None)\\n    icol = next((cols[k] for k in [\'item_id\', \'asin\', \'productid\'] if k in cols), None)\\n    rcol = next((cols[k] for k in [\'rating\', \'overall\', \'score\'] if k in cols), None)\\n    if not all([ucol, icol, rcol]):\\n        raise ValueError(f\'Amazon schema mismatch. Columns found: {list(raw.columns)}\')\\n    df = raw[[ucol, icol, rcol]].rename(columns={ucol: \'user\', icol: \'item\', rcol: \'rating\'})\\n    df = df[df[\'rating\'] > 3][[\'user\', \'item\']]\\n    return k_core_filter(df)\\n\\n\\ndef load_lastfm(path):\\n    require_file(path)\\n    df = pd.read_csv(path, sep=\'\\\\t\')\\n    cols = {c.lower(): c for c in df.columns}\\n    ucol = next((cols[k] for k in [\'userid\', \'userid\', \'user\'] if k in cols), None)\\n    icol = next((cols[k] for k in [\'artistid\', \'itemid\', \'artist\'] if k in cols), None)\\n    if not all([ucol, icol]):\\n        raise ValueError(f\'LastFM schema mismatch. Columns found: {list(df.columns)}\')\\n    out = df[[ucol, icol]].rename(columns={ucol: \'user\', icol: \'item\'})\\n    return k_core_filter(out)\\n\\n\\ndef user_holdout_split(df, seed, test_frac=0.2):\\n    rng = np.random.default_rng(seed)\\n    train_parts, test_parts = [], []\\n    eligible_users, excluded_users = 0, 0\\n    for _, udf in df.groupby(\'user\', sort=False):\\n        n = len(udf)\\n        if n < 2:\\n            excluded_users += 1\\n            continue\\n        n_test = max(1, int(np.floor(n * test_frac)))\\n        if n_test >= n:\\n            n_test = n - 1\\n        if n_test < 1 or (n - n_test) < 1:\\n            excluded_users += 1\\n            continue\\n        eligible_users += 1\\n       