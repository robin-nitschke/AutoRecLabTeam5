pend({\'seed\': seed, \'algorithm\': aname, \'n_train\': len(train), \'timestamp\': timestamp})\\n                experiment_data[dname][\'metrics\'][\'val\'].append(metric_df.to_dict(\'records\'))\\n                experiment_data[dname][\'losses\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'loss\': np.nan, \'timestamp\': timestamp})\\n                experiment_data[dname][\'losses\'][\'val\'].append({\'seed\': seed, \'algorithm\': aname, \'loss\': np.nan, \'timestamp\': timestamp})\\n                experiment_data[dname][\'predictions\'].append({\'seed\': seed, \'algorithm\': aname, \'rows\': recs_df.to_dict(\'records\')})\\n                experiment_data[dname][\'ground_truth\'].append({\'seed\': seed, \'algorithm\': aname, \'truth\': {str(u): list(v) for u, v in truth.items()}})\\n                print(metric_df[[\'metric_name\', \'k\', \'score\']].to_string(index=False))\\n            except Exception as e:\\n                print(f\'Failure on {dname} {aname} seed={seed}: {e}\')\\n                run_rows.append({\'dataset\': dname, \'algorithm\': aname, \'seed\': seed, \'evaluation_user_count\': eval_users, \'excluded_user_count\': excluded_users, \'timestamp\': timestamp, \'status\': f\'failed: {e}\'})\\n\\nresults = pd.concat(results_long, ignore_index=True) if results_long else pd.DataFrame(columns=[\'dataset\', \'algorithm\', \'seed\', \'metric_name\', \'k\', \'score\', \'evaluation_user_count\', \'excluded_user_count\', \'timestamp\'])\\nruns = pd.DataFrame(run_rows)\\n\\nresults.to_csv(os.path.join(working_dir, \'seed_sensitivity_results_long.csv\'), index=False)\\nruns.to_csv(os.path.join(working_dir, \'run_status.csv\'), index=False)\\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data, allow_pickle=True)\\nsave_np_records(\'results_long.npy\', results)\\nsave_np_records(\'run_status.npy\', runs)\\n\\nsummary = results.groupby([\'dataset\', \'algorithm\', \'metric_name\', \'k\']).agg(\\n    mean_score=(\'score\', \'mean\'),\\n    std_score=(\'score\', \'std\'),\\n    min_score=(\'score\', \'min\'),\\n    max_score=(\'score\', \'max\'),\\n    mean_eval_users=(\'evaluation_user_count\', \'mean\'),\\n    n_seeds=(\'seed\', \'nunique\')\\n).reset_index()\\nsummary[\'cv\'] = summary[\'std_score\'] / summary[\'mean_score\'].replace(0, np.nan)\\nsummary.to_csv(os.path.join(working_dir, \'metric_summary_long.csv\'), index=False)\\nsave_np_records(\'metric_summary_long.npy\', summary)\\n\\nsens = summary.sort_values([\'std_score\', \'cv\'], ascending=False)\\nmost_sensitive = sens.head(10)\\nleast_sensitive = sens.sort_values([\'std_score\', \'cv\'], ascending=True).head(10)\\nmost_sensitive.to_csv(os.path.join(working_dir, \'most_sensitive_cases.csv\'), index=False)\\nleast_sensitive.to_csv(os.path.join(working_dir, \'least_sensitive_cases.csv\'), index=False)\\n\\nprint(\'\\\\nPer-seed tidy results:\')\\nprint(results.head(20).to_string(index=False))\\nprint(\'\\\\nSummary across seeds:\')\\nprint(summary.to_string(index=False))\\nprint(\'\\\\nMost seed-sensitive cases (highest std/cv):\')\\nprint(most_sensitive[[\'dataset\', \'algorithm\', \'metric_name\', \'k\', \'mean_score\', \'std_score\', \'cv\']].to_string(index=False))\\n\\nif not most_sensitive.empty:\\n    top = most_sensitive.iloc[0]\\n    bot = least_sensitive.iloc[0]\\n    print(f\\"\\\\nAnalysis: Highest split-seed sensitivity is {top[\'dataset\']} / {top[\'algorithm\']} on {top[\'metric_name\']}@{int(top[\'k\'])} (std={top[\'std_score\']:.4f}, cv={top[\'cv\']:.4f}).\\")\\n    print(f\\"Lowest observed sensitivity is {bot[\'dataset\']} / {bot[\'algorithm\']} on {bot[\'metric_name\']}@{int(bot[\'k\'])} (std={bot[\'std_score\']:.4f}, cv={bot[\'cv\']:.4f}).\\")\\n    by_alg = summary.groupby(\'algorithm\')[\'std_score\'].mean().sort_values(ascending=False)\\n    by_data = summary.groupby(\'dataset\')[\'std_score\'].mean().sort_values(ascending=False)\\n    print(\'Average sensitivity by algorithm:\')\\n    print(by