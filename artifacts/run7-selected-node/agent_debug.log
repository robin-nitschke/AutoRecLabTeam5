ncat(train_parts, ignore_index=True)\n    test = pd.concat(test_parts, ignore_index=True)\n    return train, test, eval_users\n\n\ndef build_algorithms():\n    return {\n        \'ALS\': Recommender.adapt(ImplicitMF()),\n        \'ItemKNN\': Recommender.adapt(ItemItem()),\n        \'Pop\': Recommender.adapt(Popular())\n    }\n\n\ndef _metric_user_arrays(rec_df, truth, k):\n    rows = rec_df[rec_df[\'rank\'] <= k][[\'user\', \'item\', \'rank\']].copy()\n    rec_map = rows.sort_values([\'user\', \'rank\']).groupby(\'user\')[\'item\'].apply(list).to_dict()\n    precs, ndcgs = [], []\n    for u, gt in truth.items():\n        ranked = rec_map.get(u, [])[:k]\n        hits = [1 if it in gt else 0 for it in ranked]\n        precs.append(sum(hits) / k)\n        dcg = sum(rel / np.log2(i + 2) for i, rel in enumerate(hits))\n        idcg = sum(1 / np.log2(i + 2) for i in range(min(len(gt), k)))\n        ndcgs.append(dcg / idcg if idcg > 0 else 0.0)\n    return np.asarray(precs, float), np.asarray(ndcgs, float)\n\n\ndef evaluate_algo(algo, train, test, ks):\n    algo.fit(train)\n    users = np.array(sorted(test[\'user\'].unique()))\n    recs = batch.recommend(algo, users, MAX_K)\n    train_items = train.groupby(\'user\')[\'item\'].apply(set).to_dict()\n    truth = test.groupby(\'user\')[\'item\'].apply(set).to_dict()\n    recs = recs[~recs.apply(lambda r: r[\'item\'] in train_items.get(r[\'user\'], set()), axis=1)].copy()\n    recs[\'rank\'] = recs.groupby(\'user\').cumcount() + 1\n    recs = recs[recs[\'rank\'] <= MAX_K].copy()\n    out = []\n    for k in ks:\n        p, n = _metric_user_arrays(recs, truth, k)\n        out.append((f\'Precision\', k, float(np.mean(p)) if len(p) else np.nan))\n        out.append((f\'nDCG\', k, float(np.mean(n)) if len(n) else np.nan))\n    return recs, truth, out\n\n\ndatasets = {}\nloaders = {\n    \'ml100k\': lambda: load_ml100k(\'u.data\'),\n    \'amazon_videogames\': lambda: load_amazon(\'VideoGames.csv\'),\n    \'lastfm\': lambda: load_lastfm(\'UserTaggedArtists-timestamps.dat\')\n}\nfor name, fn in loaders.items():\n    datasets[name] = fn()\n    print(f\'Loaded {name}: {len(datasets[name])} interactions, {datasets[name].user.nunique()} users, {datasets[name].item.nunique()} items\')\n\nresults_long, run_status = [], []\nfor dname, df in datasets.items():\n    for seed in SEEDS:\n        try:\n            train, test, eval_users = user_holdout_split(df, seed=seed, test_frac=0.2)\n        except Exception as e:\n            run_status.append({\'dataset\': dname, \'seed\': seed, \'algorithm\': None, \'status\': \'split_failed\', \'error\': str(e), \'timestamp\': TS})\n            continue\n        for aname, algo in build_algorithms().items():\n            print(f\'Epoch {seed}: validation_loss = {float("nan"):.4f}\')\n            try:\n                recs, truth, metrics = evaluate_algo(algo, train, test, KS)\n                run_status.append({\'dataset\': dname, \'seed\': seed, \'algorithm\': aname, \'status\': \'ok\', \'error\': \'\', \'timestamp\': TS})\n                for mname, k, score in metrics:\n                    results_long.append({\n                        \'dataset\': dname, \'algorithm\': aname, \'seed\': seed,\n                        \'metric_name\': mname, \'k\': k, \'score\': score,\n                        \'evaluation_user_count\': eval_users, \'timestamp\': TS\n                    })\n                experiment_data[dname][\'metrics\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'n_train\': len(train), \'timestamp\': TS})\n                experiment_data[dname][\'metrics\'][\'val\'].append({\'seed\': seed, \'algorithm\': aname, \'n_test\': len(test), \'evaluation_user_count\': eval_users, \'timestamp\': TS})\n                experiment_data[dname][\'losses\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'loss\': np.nan, \'timestamp\': TS})\n                experiment_data[dname][\'losses\'][\'val\'].append({\'seed\': seed, \'algorithm\': aname, \'loss\': np.nan, \'timestamp\': TS})\n                experiment_data[dname][\'predictions\'].append({\'seed\': seed, \'algorithm\': aname, \'rows\': recs.to_dict(\'records\')[:5000]})\n                experiment_data[dname][\'ground_truth\'].append({\'seed\': seed, \'algorithm\': aname, \'truth\': {str(k): list(v) for k, v in list(truth.items())[:5000]}})\n                pretty = {(m, k): round(s, 4) for m, k, s in metrics}\n                print(dname, aname, seed, \'users=\', eval_users, pretty)\n            except Exception as e:\n                run_status.append({\'dataset\': dname, \'seed\': seed, \'algorithm\': aname, \'status\': \'fit_or_eval_failed\', \'error\': str(e), \'timestamp\': TS})\n                for mname in [\'Precision\', \'nDCG\']:\n                    for k in KS:\n                        results_long.append({\n                            \'dataset\': dname, \'algorithm\': aname, \'seed\': seed,\n                            \'metric_name\': mname, \'k\': k, \'score\': np.nan,\n                            \'evaluation_user_count\': eval_users, \'timestamp\': TS\n                        })\n                print(dname, aname, seed, \'FAILED:\', e)\n\nresults = pd.DataFrame(results_long)\nstatus_df = pd.DataFrame(run_status)\nresults.to_csv(os.path.join(working_dir, \'seed_sensitivity_results_tidy.csv\'), index=False)\nstatus_df.to_csv(os.path.join(working_dir, \'run_status.csv\'), index=False)\n\nsummary = results.groupby([\'dataset\', \'algorithm\', \'metric_name\', \'k\'], dropna=False).agg(\n    mean_score=(\'score\', \'mean\'),\n    std_score=(\'score\', \'std\'),\n    min_score=(\'score\', \'min\'),\n    max_score=(\'score\', \'max\'),\n    n_runs=(\'score\', \'count\'),\n    evaluation_user_count=(\'evaluation_user_count\', \'mean\')\n).reset_index()\nsummary[\'cv\'] = summary[\'std_score\'] / summary[\'mean_score\'].replace(0, np.nan)\nsummary[\'ci95\'] = 1.96 * (summary[\'std_score\'] / np.sqrt(summary[\'n_runs\'].clip(lower=1)))\nsummary.to_csv(os.path.join(working_dir, \'metric_summary_tidy.csv\'), index=False)\n\nseed_sensitivity = summary.sort_values([\'metric_name\', \'k\', \'std_score\', \'cv\'], ascending=[True, True, False, False])\nseed_sensitivity.to_csv(os.path.join(working_dir, \'seed_sensitivity_ranked.csv\'), index=False)\n\nwide = results.pivot_table(index=[\'dataset\', \'algorithm\', \'seed\', \'evaluation_user_count\'], columns=[\'metric_name\', \'k\'], values=\'score\').reset_index()\nwide.columns = [\'dataset\', \'algorithm\', \'seed\', \'evaluation_user_count\'] + [f\'{a}@{b}\' for a, b in wide.columns.tolist()[4:]]\nwide.to_csv(os.path.join(working_dir, \'seed_sensitivity_wide.csv\'), index=False)\n\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data, allow_pickle=True)\nnp.save(os.path.join(working_dir, \'results_long.npy\'), results.to_records(index=False), allow_pickle=True)\nnp.save(os.path.join(working_dir, \'summary_tidy.npy\'), summary.to_records(index=False), allow_pickle=True)\nnp.save(os.path.join(working_dir, \'run_status.npy\'), status_df.to_records(index=False), allow_pickle=True)\nnp.savez_compressed(os.path.join(working_dir, \'all_outputs.npz\'), results=results.to_records(index=False), summary=summary.to_records(index=False), status=status_df.to_records(index=False))\n\nprint(\'\\nPer-seed tidy results (head):\')\nprint(results.head(18).to_string(index=False))\nprint(\'\\nCross-seed summary:\')\nprint(summary.sort_values([\'dataset\', \'algorithm\', \'metric_name\', \'k\']).to_string(index=False))\n\nfocus = summary[summary[\'k\'].isin([10])].copy()\nfocus = focus.sort_values([\'metric_name\', \'std_score\', \'cv\'], ascending=[True, False, False])\nprint(\'\\nMost seed-sensitive dataset/algorithm pairs at k=10:\')\nprint(focus[[\'dataset\', \'algorithm\', \'metric_name\', \'k\', \'mean_score\', \'std_score\', \'cv\', \'min_score\', \'max_score\']].head(12).to_string(index=False))\n\nprint(\'\\nLeast seed-sensitive dataset/algorithm pair