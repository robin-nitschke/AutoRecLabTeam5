\'algorithm\'] = aname\\n                met_df[\'seed\'] = seed\\n                met_df[\'evaluation_user_count\'] = eval_users\\n                met_df[\'timestamp\'] = ts\\n                all_results.append(met_df)\\n                experiment_data[dname][\'metrics\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'n_train\': len(train), \'timestamp\': ts})\\n                experiment_data[dname][\'metrics\'][\'val\'].append(met_df.to_dict(\'records\'))\\n                experiment_data[dname][\'losses\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'loss\': np.nan, \'timestamp\': ts})\\n                experiment_data[dname][\'losses\'][\'val\'].append({\'seed\': seed, \'algorithm\': aname, \'loss\': np.nan, \'timestamp\': ts})\\n                experiment_data[dname][\'predictions\'].append({\'seed\': seed, \'algorithm\': aname, \'rows\': recs.to_dict(\'records\')})\\n                experiment_data[dname][\'ground_truth\'].append({\'seed\': seed, \'algorithm\': aname, \'truth\': {str(k): list(v) for k, v in truth.items()}})\\n                pretty = met_df[[\'metric_name\', \'k\', \'score\']].copy()\\n                pretty[\'mk\'] = pretty[\'metric_name\'] + \'@\' + pretty[\'k\'].astype(str)\\n                print(dname, aname, seed, dict(zip(pretty[\'mk\'], pretty[\'score\'].round(4))))\\n            except Exception as e:\\n                failed_runs.append({\'dataset\': dname, \'seed\': seed, \'algorithm\': aname, \'error\': str(e)})\\n                print(f\'Run failed: {dname} {aname} seed={seed}: {e}\')\\n\\nresults = pd.concat(all_results, ignore_index=True) if all_results else pd.DataFrame(columns=[\'dataset\',\'algorithm\',\'seed\',\'metric_name\',\'k\',\'score\',\'evaluation_user_count\',\'timestamp\'])\\nresults = results[[\'dataset\',\'algorithm\',\'seed\',\'metric_name\',\'k\',\'score\',\'evaluation_user_count\',\'timestamp\']]\\nresults.to_csv(os.path.join(working_dir, \'seed_sensitivity_results_tidy.csv\'), index=