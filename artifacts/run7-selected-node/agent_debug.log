\'MovieLens schema mismatch\')\\n    df = df[df[\'rating\'] > 3][[\'user\', \'item\']].drop_duplicates()\\n    return k_core_filter(df)\\n\\n\\ndef load_amazon(path=\'VideoGames.csv\'):\\n    ensure_file(path)\\n    raw = pd.read_csv(path)\\n    if raw.shape[1] < 3:\\n        raise ValueError(\'Amazon file must have at least 3 columns\')\\n    cols = {c.lower(): c for c in raw.columns}\\n    ucol = cols.get(\'user_id\', cols.get(\'userid\', cols.get(\'reviewerid\', raw.columns[0])))\\n    icol = cols.get(\'item_id\', cols.get(\'asin\', raw.columns[1]))\\n    rcol = cols.get(\'rating\', cols.get(\'overall\', raw.columns[2]))\\n    need = [ucol, icol, rcol]\\n    if any(c not in raw.columns for c in need):\\n        raise ValueError(\'Amazon schema mismatch\')\\n    df = raw[need].rename(columns={ucol: \'user\', icol: \'item\', rcol: \'rating\'})\\n    df = df[df[\'rating\'] > 3][[\'user\', \'item\']].drop_duplicates()\\n    return k_core_filter(df)\\n\\n\\ndef load_lastfm(path=\'UserTaggedArtists-timestamps.dat\'):\\n    ensure_file(path)\\n    raw = pd.read_csv(path, sep=\'\\\\t\')\\n    cols = {c.lower(): c for c in raw.columns}\\n    ucol = cols.get(\'userid\', raw.columns[0])\\n    icol = cols.get(\'artistid\', raw.columns[1])\\n    if ucol not in raw.columns or icol not in raw.columns:\\n        raise ValueError(\'LastFM schema mismatch\')\\n    df = raw[[ucol, icol]].rename(columns={ucol: \'user\', icol: \'item\'}).drop_duplicates()\\n    return k_core_filter(df)\\n\\n\\ndef user_holdout_split(df, seed=42, test_frac=0.2):\\n    rng = np.random.default_rng(seed)\\n    train_parts, test_parts, kept_users = [], [], []\\n    for u, udf in df.groupby(\'user\', sort=False):\\n        n = len(udf)\\n        if n < 2:\\n            continue\\n        n_test = max(1, int(np.floor(n * test_frac)))\\n        if n - n_test < 1:\\n            n_test = n - 1\\n        if n_test < 1 or (n - n_test) < 1:\\n            continue\\n        idx = np.arange(n)\\n        tix = rng.choice(idx, size=n_test, replace=False)\\n        mask = np.zeros(n, dtype=bool)\\n        mask[tix] = True\\n        train_parts.append(udf.iloc[~mask])\\n        test_parts.append(udf.iloc[mask])\\n        kept_users.append(u)\\n    if not train_parts or not test_parts:\\n        raise ValueError(\'No users support the holdout split\')\\n    train = pd.concat(train_parts, ignore_index=True)\\n    test = pd.concat(test_parts, ignore_index=True)\\n    return train, test, kept_users\\n\\n\\ndef build_algorithms():\\n    return {\\n        \'ALS\': Recommender.adapt(ImplicitMF()),\\n        \'ItemKNN\': Recommender.adapt(ItemItem()),\\n        \'Pop\': Recommender.adapt(Popular())\\n    }\\n\\n\\ndef score_user_metrics(rec_items, truth_items, ks):\\n    rows = []\\n    truth_set = set(truth_items)\\n    for k in ks:\\n        topk = rec_items[:k]\\n        hits = [1 if it in truth_set else 0 for it in topk]\\n        prec = float(np.sum(hits) / k)\\n        dcg = sum(rel / np.log2(i + 2) for i, rel in enumerate(hits))\\n        ideal = min(len(truth_set), k)\\n        idcg = sum(1.0 / np.log2(i + 2) for i in range(ideal))\\n        ndcg = float(dcg / idcg) if idcg > 0 else 0.0\\n        rows.append((k, prec, ndcg))\\n    return rows\\n\\n\\ndef evaluate_algo(algo, train, test, dataset_name, algo_name, seed):\\n    try:\\n        algo.fit(train)\\n        users = test[\'user\'].drop_duplicates().tolist()\\n        try:\\n            recs = batch.recommend(algo, users, n=MAX_K, candidates=None)\\n        except TypeError:\\n            recs = batch.recommend(algo, users, MAX_K)\\n    except Exception as e:\\n        print(f\'Failure on {dataset_name}/{algo_name}/seed={seed}: {e}\')\\n        return None, None, None\\n\\n    truth = test.groupby(\'user\')[\'item\'].apply(list).to_dict()\\n    seen = train.groupby(\'user\')[\'item\'].apply(set).to_dict()\\n    recs = recs.sort_values([\'user\', \'rank\']) if \'rank\' in recs.columns else recs.copy()\\n    filtered = []\\n    for u, udf in recs.groupby(\'user\', sort=False):\\n        s = seen.get(u, set())\\n        items = [it for it in udf[\'item\'].tolist() if it not in s][:MAX_K]\\n        for r, it in enumerate(items, start=1):\\n            filtered.append((u, it, r))\\n    frecs = pd.DataFrame(filtered, columns=[\'user\', \'item\', \'rank\'])\\n    rec_map = frecs.groupby(\'user\')[\'item\'].apply(list).to_dict() if not frecs.empty else {}\\n    eval_users = sorted(set(truth.keys()))\\n    long_rows = []\\n    user_rows = []\\n    for u in eval_users:\\n        user_scores = score_user_metrics(rec_map.get(u, []), truth[u], KS)\\n        for k, prec, ndcg in user_scores:\\n            user_rows.append((u, \'Precision\', k, prec))\\n            user_rows.append((u, \'nDCG\', k, ndcg))\\n    um = pd.DataFrame(user_rows, columns=[\'user\', \'metric_name\', \'k\', \'score\'])\\n    agg = um.groupby([\'metric_name\', \'k\'], as_index=False)[\'score\'].mean()\\n    for _, row in agg.iterrows():\\n        long_rows.append({\\n            \'dataset\': dataset_name,\\n            \'algorithm\': algo_name,\\n            \'seed\': seed,\\n            \'metric_name\': row[\'metric_name\'],\\n            \'k\': int(row[\'k\']),\\n            \'score\': float(row[\'score\']),\\n            \'evaluation_user_count\': len(eval_users)\\n        })\\n    return pd.DataFrame(long_rows), frecs, truth\\n\\n\\ndatasets = {}\\nloaders = {\\n    \'ml100k\': load_ml100k,\\n    \'amazon_videogames\': load_amazon,\\n    \'lastfm\': load_lastfm,\\n}\\nfor name, loader in loaders.items():\\n    datasets[name] = loader({\\n        \'ml100k\': \'u.data\',\\n        \'amazon_videogames\': \'VideoGames.csv\',\\n        \'lastfm\': \'UserTaggedArtists-timestamps.dat\'\\n    }[name])\\n    df = datasets[name]\\n    print(f\'Loaded {name}: interactions={len(df)}, users={df.user.nunique()}, items={df.item.nunique()}\')\\n\\nall_long = []\\nrun_status = []\\nfor dname, df in datasets.items():\\n    for seed in SEEDS:\\n        train, test, kept_users = user_holdout_split(df, seed=seed, test_frac=0.2)\\n        eval_user_count = test[\'user\'].nunique()\\n        print(f\'{dname} seed={seed}: eval_users={eval_user_count}\')\\n        algos = build_algorithms()\\n        for aname, algo in algos.items():\\n            print(f\'Epoch {seed}: validation_loss = {float(\\"nan\\"):.4f}\')\\n            out, recs, truth = evaluate_algo(algo, train, test, dname, aname, seed)\\n            ts = pd.Timestamp.now().isoformat()\\n            status = {\'dataset\': dname, \'algorithm\': aname, \'seed\': seed, \'evaluation_user_count\': eval_user_count, \'timestamp\': ts, \'status\': \'ok\' if out is not None else \'failed\'}\\n            run_status.append(status)\\n            experiment_data[dname][\'metrics\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'n_train\': len(train), \'timestamp\': ts})\\n            experiment_data[dname][\'losses\'][\'train\'].append({\'seed\': seed, \'algorithm\': aname, \'loss\': np.nan, \'timestamp\': ts})\\n            experiment_data[dname][\'losses\'][\'val\'].append({\'seed\': seed, \'algorithm\': aname, \'loss\': np.nan, \'timestamp\': ts})\\n            if out is not None:\\n                all_long.append(out)\\n                experiment_data[dname][\'metrics\'][\'val\'].extend(out.assign(timestamp=ts).to_dict(\'records\'))\\n                experiment_data[dname][\'predictions\'].append({\'seed\': seed, \'algorithm\': aname, \'rows\': [] if recs is None else recs.to_dict(\'records\')})\\n                experiment_data[dname][\'ground_truth\'].append({\'seed\': seed, \'algorithm\': aname, \'truth\': {str(k): list(v) for k, v in truth.items()}})\\n                printable = out.pivot_table(index=[\'dataset\',\'algorithm\',\'seed\'], columns=[\'metric_name\',\'k\'], values=\'score\')\\n                print(printable.round(4))\\n            else:\\n                experiment_data[dname][\'predictions\'].append({\'seed\': seed, \'algorithm\': aname, \'rows\': []})\\n                experiment_data[dname][\'ground_truth\'].append({\'seed\': seed, \'algorithm\': aname, \'truth\': {}})\\n\\nresults_long = pd.concat(all_long, ignore_index=True) if all_long else pd.DataFrame(columns=[\'dataset\',\'algorithm\',\'seed\',\'metric_name\',\'k\',\'score\',\'evaluation_user_count\'])\\nstatus_df = pd.DataFrame(run_status)\\nresults_long.to_csv(os.path.join(working_dir, \'seed_sensitivity_results_long.csv\'), index=False)\\nstatus_df.to_csv(os.path.join(working_dir, \'run_status.csv\'), index=False)\\n\\nsummary = results_long.groupby([\'dataset\',\'algorithm\',\'metric_name\',\'k\'], as_index=False).agg(\\n    mean_score=(\'score\',\'mean\'),\\n    std_score=(\'score\', lambda x: float(np.std(x, ddof=1)) if len(x) > 1 else np.nan),\\n    min_score=(\'score\',\'min\'),\\n    max_score=(\'score\',\'max\'),\\n    n_seeds=(\'score\',\'count\'),\\n    evaluation_user_count=(\'evaluation_user_count\',\'mean\')\\n)\\nsummary[\'cv\'] = summary[\'std_score\'] / summary[\'mean_score\'].replace(0, np.nan)\\nsummary[\'ci95\'] = 1.96 * summary[\'std_score\'] / np.sqrt(summary[\'n_seeds\'].clip(lower=1))\\nsummary[\'range\'] = summary[\'max_score\'] - summary[\'min_score\']\\nsummary.to_csv(os.path.join(working_dir, \'metric_summary_long.csv\'), index=False)\\n\\nseed_var = summary.sort_values([\'cv\',\'std_score\',\'range\'], ascending=False)\\nprint(\'\\\\nSeed-sensitivity summary (top by CV):\')\\nprint(seed_var[[\'dataset\',\'algorithm\',\'metric_name\',\'k\',\'mean_score\',\'std_score\',\'cv\',\'range\',\'ci95\']].head(12).round(4))\\nif len(seed_var):\\n    top = seed_var.iloc[0]\\n    print(f\\"Most seed-sensitive: dataset={top[\'dataset\']}, algorithm={top[\'algorithm\']}, metric={top[\'metric_name\']}@{int(top[\'k\'])}, cv={top[\'cv\']:.4f}, std={top[\'std_score\']:.4f}, range={top[\'range\']:.4f}\\")\\n\\nanalysis_rows = []\\nfor (d, a, m, k), g in results_long.groupby([\'dataset\',\'algorithm\',\'metric_name\',\'k\']):\\n    vals = g.sort_values(\'seed\')[\'score\'].to_numpy()\\n    if len(vals) >= 2:\\n        sw = stats.shapiro(vals) if len(vals) >= 3 else (np.nan, np.nan)\\n        analysis_rows.append({\\n            \'dataset\': d, \'algorithm\': a, \'metric_name\': m, \'k\': k,\\n            \'n_seeds\': len(vals), \'mean_score\': float(np.mean(vals)), \'std_score\': float(np.std(vals, ddof=1)),\\n            \'cv\': float(np.std(vals, ddof=1) / np.mean(vals)) if np.mean(vals) != 0 else np.nan,\\n            \'range\': float(np.max(vals) - np.min(vals)),\\n            \'shapiro_stat\': sw[0] if isinstance(sw, tuple) else np.nan,\\n            \'shapiro_p\': sw[1] if isinstance(sw, tuple) else np.nan\\n        })\\nanalysis_df = pd.DataFrame(analysis_rows)\\nanalysis_df.to_csv(os.path.join(working_dir, \'seed_sensitivity_analysis.csv\'), index=False)\\n\\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data, allow_pickle=True)\\nnp.save(os.path.join(working_dir, \'results_long.npy\'), results_long.to_records(index=False), allow_pickle=True)\\nnp.save(os.path.join(working_dir, \'summary_long.npy\'), summary.to_records(index=False), allow_pickle=True)\\nnp.save(os.path.join(working_dir, \'analysis_long.npy\'), analysis_df.to_records(index=False), allow_pickle=True)\\n\\nprint(\'\\\\nPer-seed tidy results:\')\\nprint(results_long.sort_values([\'dataset\',\'algorithm\',\'seed\',\'metric_name\',\'k\']).round(4).to_string(index=False))\\nprint(\'\\\\nAcross-seed summary:\')\\nprint(summary.sort_values([\'dataset\',\'metric_name\',\'k\',\'algorithm\']).round(4).to_string(index=False))\\nprint(f\'\\\\nSaved outputs to: {working_dir}\')"}', name='return_plan_and_code'), type='function')]))[/cyan]
